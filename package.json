{
  "name": "dsh-oh-my-terminal",
  "version": "0.2.1",
  "description": "DSH Web GUI 底部终端面板插件——node-pty 驱动的多标签交互式终端（Windows ConPTY / POSIX openpty）",
  "type": "module",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "immediately": false
    }
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-brand": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-shortcuts": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/ws": "^8.5.0",
    "esbuild": "~0.28.0",
    "react": "^18.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsx scripts/build.ts"
  },
  "engines": {
    "node": "^20.19.0 || >=22.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
